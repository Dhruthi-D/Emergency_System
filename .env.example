# Copy to .env and fill in secrets (especially MYSQL_PASSWORD, DJANGO_SECRET_KEY).

DJANGO_SECRET_KEY=dev-secret-change-me-before-production
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

MYSQL_DB=smart_city
MYSQL_USER=root
MYSQL_PASSWORD=
