MYSQL_PORT=3306

DJANGO_API_BASE=http://localhost:8000
DJANGO_SENSOR_URL=http://localhost:8000/api/sensor-alert/

RECEIVER_UDP_PORT=5005

SENSOR_SERVER_HOST=0.0.0.0
SENSOR_SERVER_PORT=5050

REACT_APP_API_BASE_URL=http://localhost:8000/api/
REACT_APP_WS_URL=ws://localhost:8000/ws/incidents/
